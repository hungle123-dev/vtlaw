# Copy to .env and fill in. Never commit .env.

# --- Neo4j (docker-compose maps Bolt to 17687 on localhost) ---
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<choose-a-password>
NEO4J_DATABASE=neo4j

# --- Redis (docker-compose maps to 16379 on localhost) ---
REDIS_URL=redis://localhost:16379/0
ANSWER_CACHE_TTL=3600
RETRIEVAL_CACHE_TTL=1800

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, vLLM, Ollama, ...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-key>
LLM_MODEL=google/gemini-2.5-flash

# --- Embedding / rerank (HuggingFace ids; revisions pinned in config.py) ---
EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANK_MODEL=AITeamVN/Vietnamese_Reranker
EMBED_DEVICE=auto

# --- API ---
API_HOST=127.0.0.1
API_PORT=18080
