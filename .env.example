# Copy to .env and fill in. Never commit .env.

# --- Neo4j (docker-compose maps Bolt to 17687 on localhost) ---
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<choose-a-password>
NEO4J_DATABASE=neo4j

# --- Redis (docker-compose maps to 16379 on localhost) ---
REDIS_URL=redis://localhost:16379/0
ANSWER_CACHE_TTL=3600
RETRIEVAL_CACHE_TTL=1800

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, vLLM, Ollama, ...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-key>
# Free-tier quota is per model, so the choice is a budget decision, not just a
# quality one. Measured on this project's key: gemini-2.5-flash allowed 20
# requests/day (below Google's published 250) and ran out mid-session, while
# flash-lite kept answering. A 429 is retried automatically — see
# LLM_MAX_RETRIES — but no retry conjures quota that is spent.
LLM_MODEL=gemini-2.5-flash-lite
# LLM_MAX_RETRIES=5
# LLM_RETRY_BASE_S=2.0

# --- Embedding / rerank (HuggingFace ids; revisions pinned in config.py) ---
EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANK_MODEL=AITeamVN/Vietnamese_Reranker
EMBED_DEVICE=auto

# --- API ---
API_HOST=127.0.0.1
API_PORT=18080
