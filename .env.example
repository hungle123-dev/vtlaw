# Copy to .env and fill in. Never commit .env.

# --- Neo4j (docker-compose maps Bolt to 17687 on localhost) ---
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<choose-a-password>
NEO4J_DATABASE=neo4j

# --- Redis (docker-compose maps to 16379 on localhost) ---
REDIS_URL=redis://localhost:16379/0
ANSWER_CACHE_TTL=3600
RETRIEVAL_CACHE_TTL=1800

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, vLLM, Ollama, ...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-key>
# Free-tier quota is per model, so the choice is a budget decision, not just a
# quality one. Measured on this project's key: gemini-2.5-flash allowed 20
# requests/day (below Google's published 250) and ran out mid-session, while
# flash-lite kept answering. A 429 is retried automatically — see
# LLM_MAX_RETRIES — but no retry conjures quota that is spent.
#
# Keep the `vendor/` prefix when LLM_BASE_URL is OpenRouter: it routes on the
# full id, so a bare `gemini-2.5-flash-lite` 404s. Drop the prefix only for a
# provider's own endpoint (e.g. `gpt-4o-mini` against api.openai.com/v1).
LLM_MODEL=google/gemini-2.5-flash-lite
# LLM_MAX_RETRIES=5
# LLM_RETRY_BASE_S=2.0

# --- Embedding / rerank (HuggingFace ids; revisions pinned in config.py) ---
EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANK_MODEL=AITeamVN/Vietnamese_Reranker
EMBED_DEVICE=auto
# Keep the reproducible baseline deterministic and inexpensive. Enable either
# only as a separately recorded experiment, then re-run `vtlaw eval run`.
RERANK_ENABLED=false
DECOMPOSE_QUERIES=false
# Set false to preserve the no-LLM-routing baseline even when LLM generation is enabled.
INTENT_ROUTER_ENABLED=true

# --- Retrieval budget (server-side only; never overridable per request) ---
# FETCH_K candidates per leg before fusion, CONTEXT_K provisions into the prompt.
# OVERFETCH_FACTOR multiplies each leg's index query before the effective-date
# filter runs: Neo4j's vector index has no pre-filter, so without headroom an
# ineligible hit evicts an eligible one. All three are recorded in eval
# artifacts and in the cache key, so changing one invalidates stale results.
# FETCH_K=30
# CONTEXT_K=8
# OVERFETCH_FACTOR=4

# --- API ---
API_HOST=127.0.0.1
API_PORT=18080

# Gate /chat. Empty leaves it open, which is fine on loopback and logged as a
# warning at startup. Every /chat call spends LLM tokens and CPU, so set this
# before binding API_HOST to anything but loopback — the startup log escalates to
# ERROR in that case.
API_KEY=

# Per-client budget for /chat, keyed on API key when present, else source address.
# In-process and per-worker: the effective limit is workers x this number.
RATE_LIMIT_PER_MINUTE=20

# Browser origins allowed to call the API, comma-separated. Empty sends no CORS
# headers at all, which blocks browser clients.
CORS_ORIGINS=
